{
  "name": "member-profile-feed-api",
  "version": "1.2.0",
  "engines": {
    "node": "^22.12.0"
  },
  "description": "Express + Prisma API for member profiles, photo uploads and likes",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start:dist": "node dist/index.js",
    "lint": "eslint .",
    "test": "node -r ts-node/register --test test/*.test.cjs",
    "test:db": "prisma migrate deploy && node -r ts-node/register --test --test-concurrency=1 test/db/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  }
}
