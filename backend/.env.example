# Copy to .env for running the API outside Docker.
DATABASE_URL="postgresql://USER:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/member_profiles?schema=public"
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Where uploaded photos are written; defaults to ./uploads
UPLOAD_DIR=
